<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>

<VBox xmlns:fx="http://javafx.com/fxml" fx:controller="controller.CheckoutController" spacing="10" alignment="CENTER" style="-fx-padding: 20;">

    <!-- Header Text -->
    <Text text="Checkout" style="-fx-font-size: 20px; -fx-font-weight: bold;" />

    <!-- Total Price Display -->
    <HBox spacing="10" alignment="CENTER_LEFT">
        <Text text="Total Price:" />
        <Text fx:id="totalPrice"  style="-fx-font-weight: bold;" />
    </HBox>

    <!-- Credit Card Information -->
    <HBox spacing="10" alignment="CENTER_LEFT">
        <Text text="Credit Card Number:" />
        <TextField fx:id="cardNumberField" promptText="Enter 16-digit card number" />
    </HBox>

    <HBox spacing="10" alignment="CENTER_LEFT">
        <Text text="Expiry Date (MM/YY):" />
        <TextField fx:id="expiryDateField" promptText="MM/YY" />
    </HBox>

    <HBox spacing="10" alignment="CENTER_LEFT">
        <Text text="CVV:" />
        <TextField fx:id="cvvField" promptText="3 digits" />
    </HBox>

    <!-- Confirm Button -->
    <Button text="Confirm Order" onAction="#handleCheckout" style="-fx-font-weight: bold; -fx-background-color: #4CAF50; -fx-text-fill: white;" />

</VBox>
