<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.geometry.Insets?>

<GridPane xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.SignUpController" alignment="CENTER" hgap="10" vgap="10">
    <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>

    <!-- First Name Field -->
    <Label text="First Name:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
    <TextField fx:id="signUpFirstNameField" promptText="Enter your first name" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

    <!-- Last Name Field -->
    <Label text="Last Name:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
    <TextField fx:id="signUpLastNameField" promptText="Enter your last name" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

    <!-- Email Field -->
    <Label text="Email:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
    <TextField fx:id="signUpEmailField" promptText="Enter your email" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

    <!-- Password Field -->
    <Label text="Password:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
    <PasswordField fx:id="signUpPasswordField" promptText="Enter your password" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

    <!-- Confirm Password Field -->
    <Label text="Confirm Password:" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
    <PasswordField fx:id="confirmPasswordField" promptText="Confirm your password" GridPane.rowIndex="4" GridPane.columnIndex="1"/>

    <!-- Sign Up Button -->
    <Button text="Sign Up" onAction="#handleSignUpButtonAction" GridPane.rowIndex="5" GridPane.columnIndex="1"/>

    <!-- Back to Login Button -->
    <Button text="Back to Login" onAction="#handleBackToLoginAction" GridPane.rowIndex="6" GridPane.columnIndex="1"/>

    <!-- Message Label -->
    <Label fx:id="signUpMessageLabel" GridPane.rowIndex="7" GridPane.columnIndex="1"/>
</GridPane>
