<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.RowConstraints?>

<GridPane fx:id="loginPane" alignment="CENTER" hgap="10" prefHeight="520.0" prefWidth="390.0" style="-fx-background-color: #ADD8E6;" vgap="10" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/23" fx:controller="controller.LoginController">

   <!-- Username Label/email and TextField -->
   <Label text="Username or Email:" GridPane.columnIndex="3" GridPane.rowIndex="1" />
   <TextField fx:id="usernameOrEmailField" promptText="Enter Username or Email" GridPane.columnIndex="4" GridPane.halignment="CENTER" GridPane.rowIndex="1" />
   <!-- Password Label and PasswordField -->
   <Label text="Password:" GridPane.columnIndex="3" GridPane.rowIndex="4" />
   <PasswordField fx:id="passwordField" promptText="Enter Password" GridPane.columnIndex="4" GridPane.rowIndex="4" />

   <!-- Login Button -->
   <Button onAction="#handleLoginButtonAction" text="Login" textFill="#c72929" GridPane.columnIndex="4" GridPane.rowIndex="9" GridPane.halignment="CENTER">
      <padding>
         <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
      </padding>
   </Button>

   <!-- Message Label for Login Status -->
   <Label fx:id="messageLabel" GridPane.columnIndex="4" GridPane.rowIndex="15" GridPane.vgrow="ALWAYS" />


   <!-- Forgot Password Hyperlink -->
   <Hyperlink fx:id="forgotPasswordLink" onAction="#handleForgotPasswordAction" text="Forgot Password" GridPane.columnIndex="4" GridPane.halignment="LEFT" GridPane.rowIndex="14" />

   <!-- Label Message (Optional) -->
   <Label fx:id="labelMessage" text="Label" GridPane.columnIndex="4" GridPane.halignment="CENTER" GridPane.rowIndex="16" GridPane.valignment="BASELINE" />

   <!-- Sign Up Button -->
   <Button fx:id="signupButton" mnemonicParsing="false" onAction="#handleSignUpLinkAction" text="Sign Up" textFill="#961f1f" GridPane.columnIndex="4" GridPane.halignment="CENTER" GridPane.rowIndex="10">
      <padding>
         <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
      </padding>
   </Button>

   <!-- Column and Row Constraints -->
   <columnConstraints>
      <ColumnConstraints />
      <ColumnConstraints />
      <ColumnConstraints />
      <ColumnConstraints />
      <ColumnConstraints maxWidth="144.00002441406247" minWidth="86.39998779296872" prefWidth="98.39998779296872" />
      <ColumnConstraints maxWidth="63.20001220703125" minWidth="5.5999755859375" prefWidth="51.20001220703125" />
   </columnConstraints>

   <rowConstraints>
      <RowConstraints />
      <RowConstraints />
      <RowConstraints />
      <RowConstraints />
      <RowConstraints />
      <RowConstraints />
      <RowConstraints />
      <RowConstraints />
      <RowConstraints />
      <RowConstraints />
      <RowConstraints />
      <RowConstraints />
      <RowConstraints />
      <RowConstraints />
      <RowConstraints />
      <RowConstraints />
      <RowConstraints />
      <RowConstraints />
      <RowConstraints />
   </rowConstraints>
</GridPane>
