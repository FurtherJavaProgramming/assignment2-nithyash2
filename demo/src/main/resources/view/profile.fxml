<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.geometry.Insets?>

<GridPane xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.ProfileController" alignment="CENTER" hgap="10" vgap="10">
    <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>

    <!-- First Name Field -->
    <Label text="First Name:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
    <TextField fx:id="firstNameField" promptText="Enter your first name" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

    <!-- Last Name Field -->
    <Label text="Last Name:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
    <TextField fx:id="lastNameField" promptText="Enter your last name" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

    <!-- Email Field (Read-Only) -->
    <Label text="Email:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
    <TextField fx:id="emailField" promptText="Enter your email" GridPane.rowIndex="2" GridPane.columnIndex="1" editable="false"/>

    <!-- New Password Field -->
    <Label text="New Password:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
    <PasswordField fx:id="newPasswordField" promptText="Enter new password" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

    <!-- Confirm Password Field -->
    <Label text="Confirm Password:" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
    <PasswordField fx:id="confirmPasswordField" promptText="Confirm new password" GridPane.rowIndex="4" GridPane.columnIndex="1"/>

    <!-- Save Changes Button -->
    <Button text="Save Changes" onAction="#handleSaveChanges" GridPane.rowIndex="5" GridPane.columnIndex="1"/>

    <!-- Back to Dashboard Button -->
    <Button fx:id="backButton" text="Back to Dashboard" onAction="#handleBackToDashboard" GridPane.rowIndex="6" GridPane.columnIndex="1"/>

    <!-- Message Label for Feedback -->
    <Label fx:id="messageLabel" GridPane.rowIndex="7" GridPane.columnIndex="1"/>
</GridPane>
