<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="controller.ShoppingCartController">
    <top>
        <Label text="Shopping Cart" style="-fx-font-size: 18px; -fx-font-weight: bold;" />
    </top>

    <center>
        <TableView fx:id="cartTableView" prefHeight="300.0">
            <columns>
                <TableColumn fx:id="titleColumn" text="Title" />
                <TableColumn fx:id="quantityColumn" text="Quantity" />
                <TableColumn fx:id="priceColumn" text="Price" />
                <TableColumn fx:id="totalColumn" text="Total" />
            </columns>
        </TableView>
    </center>

    <bottom>
        <HBox spacing="10" style="-fx-padding: 10;">
            <Label text="Total Cost:" />
            <Label fx:id="totalCostLabel" text="0.0" />
            <Button text="Update Quantity" onAction="#handleUpdateQuantity" />
            <Button text="Remove Selected Item" onAction="#handleRemoveItem" />
            <Button fx:id="proceedToCheckoutButton" text="Proceed to Checkout" onAction="#proceedToCheckout" />
        </HBox>
    </bottom>
</BorderPane>
