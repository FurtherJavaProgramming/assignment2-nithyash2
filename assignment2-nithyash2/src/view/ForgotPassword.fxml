<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.geometry.Insets?>

<GridPane xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.ForgotPasswordController" alignment="CENTER" hgap="10" vgap="10">
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <!-- Title Label -->
    <Label text="Forgot Password" style="-fx-font-size: 18px; -fx-font-weight: bold;" GridPane.columnIndex="0" GridPane.rowIndex="0" GridPane.columnSpan="2"/>

    <!-- Username/Email Input Field -->
    <Label text="Username or Email:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
    <TextField fx:id="usernameOrEmailField" promptText="Enter your username or email" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

    <!-- Submit Button -->
    <Button text="Submit" onAction="#handleForgotPassword" GridPane.columnIndex="1" GridPane.rowIndex="2"/>

    <!-- Feedback Message -->
    <Label fx:id="messageLabel" GridPane.columnIndex="1" GridPane.rowIndex="3"/>
</GridPane>
